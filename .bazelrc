build --workspace_status_command=./tools/workspace_status.sh
# Run the workspace status command on every build so STABLE_GIT_COMMIT is
# threaded into stamped artifacts (e.g. //app/bcr:ui_version_src).
build --stamp

# IMPORTANT:
# export JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
# build --default_system_javabase=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home

build --java_language_version=21
build --java_runtime_version=21
build --tool_java_language_version=21
build --tool_java_runtime_version=21

# for malformed docs URL archives that contain no content.  Consider putting
# this under a transistion.
common --noincompatible_disallow_empty_glob

# CI tuning. Pass `--config=ci` on CI build invocations (see
# .github/workflows/*). The deploy workflow runs on GitHub-hosted
# ubuntu-latest (4 vCPU / 16GB RAM), which is *smaller* than a typical dev
# box, so this config is mostly about staying inside the memory budget:
#
# - Analyzing //data/bazel-central-registry/modules:modules needs a large
#   server heap (set via `startup --host_jvm_args` in the workflow, since
#   startup options can't live under --config). Once analysis is done that
#   state is dead weight during execution; don't keep it around.
# - packagecompiler/bzlcompiler are persistent workers that each spawn a
#   `java -jar` server with the JVM default heap (1/4 of RAM). Bazel's
#   default of 4 instances per mnemonic can therefore claim most of the
#   machine on its own; keep it to one per mnemonic.
build:ci --notrack_incremental_state
build:ci --nokeep_state_after_build
build:ci --discard_analysis_cache
build:ci --worker_max_instances=1

# Prerender tab pool. The flag defaults (8 tabs / 27 pages per tab / 4-way
# warmup) are tuned for a 16GB / 10-CPU box, which is already the runner's
# memory class, and each tab holds the full inlined registry in its JS heap.
# Upstream's values for a 96GB self-hosted runner (24 / 50 / 8) took the
# ubuntu-latest VM down with "runner has received a shutdown signal" during
# the prerender step. Stay slightly under the defaults to leave room for
# the Bazel server + worker JVMs that share the machine.
build:ci --//app/bcr:prerender_pool_size=6
build:ci --//app/bcr:prerender_tab_max_pages=20
build:ci --//app/bcr:prerender_warmup_concurrency=3
